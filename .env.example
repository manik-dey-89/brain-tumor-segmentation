# Brain Tumor Segmentation – Environment Variables
# Copy this file to .env and fill in your values.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Brain Tumor Segmentation API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production        # development | production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Model / Inference ─────────────────────────────────────────────────────────
CONFIG_PATH=configs/config.yaml
MODEL_PATH=outputs/checkpoints/best_model.pth
DEVICE=auto                   # auto | cuda | cuda:0 | cpu
INFERENCE_THRESHOLD=0.5

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.tif,.tiff,.nii,.nii.gz
TEMP_DIR=outputs/temp

# ── History ───────────────────────────────────────────────────────────────────
HISTORY_LIMIT=100
HISTORY_FILE=outputs/logs/history.json

# ── Security (optional) ───────────────────────────────────────────────────────
# API_KEY=your-secret-api-key-here
RATE_LIMIT_PER_MINUTE=60
