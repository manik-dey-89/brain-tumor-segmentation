# Frontend environment variables
# Copy to .env.local (dev) or set in your hosting platform (production).

# Backend API base URL.
# - Leave EMPTY in development: Vite proxy forwards /api/* to localhost:8000
# - In production (Render / Vercel / etc.) set to the FULL backend URL including /api/v1:
#   VITE_API_URL=https://brain-tumor-segmentation-xsad.onrender.com/api/v1
#
# The client also accepts the bare domain (without /api/v1) and normalises it
# automatically, but using the full URL is the safest and most explicit option.
VITE_API_URL=
